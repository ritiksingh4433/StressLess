# Server Configuration
PORT=5000

# Database - PostgreSQL connection string
DATABASE_URL='postgresql://user:password@host:5432/database?sslmode=require'

# JWT Secret for authentication
JWT_SECRET="replace-with-strong-secret"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# Optional comma-separated client IDs if you use different IDs across environments.
GOOGLE_CLIENT_IDS=""

# Optional allowed frontend origins in production (comma-separated)
FRONTEND_URL="https://your-frontend-domain.com"
FRONTEND_URLS="https://your-frontend-domain.com,https://your-preview-domain.vercel.app"

# OpenRouter API Key for AI chat
OPENROUTER_API_KEY="your-openrouter-api-key"
